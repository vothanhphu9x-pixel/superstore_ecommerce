          <mxGeometry x="70" y="20" width="2880" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="PostgreSQL → Debezium → Kafka → MinIO → Bronze → Staging → [Snapshot / Silver] → Gold Dim + Fact → Mart. Sơ đồ này mô tả cột, bộ lọc, dedup và nhánh chạy; khóa bảng chi tiết nằm ở superstore-pipeline-3layer.drawio." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#526273;" vertex="1" parent="1">
          <mxGeometry x="70" y="78" width="2880" height="54" as="geometry" />
        </mxCell>

        <mxCell id="pg" value="&lt;b&gt;1 · Odoo / PostgreSQL&lt;/b&gt;&lt;br&gt;Bảng nghiệp vụ, PK/FK và thay đổi INSERT / UPDATE / DELETE.&lt;br&gt;Nguồn sống: chưa có cột phân tích hay lịch sử dimension dbt." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#EEF2F6;strokeColor=#60758B;fontColor=#193149;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="520" height="240" as="geometry" />
        </mxCell>
        <mxCell id="debezium" value="&lt;b&gt;2 · Debezium / WAL&lt;/b&gt;&lt;br&gt;Initial snapshot + CDC; một topic Kafka / bảng.&lt;br&gt;Event có op, before / after, source.ts_ms và LSN.&lt;br&gt;Không join hoặc dedup business key ở đây." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF0DD;strokeColor=#C4833A;fontColor=#503313;" vertex="1" parent="1">
          <mxGeometry x="660" y="160" width="520" height="240" as="geometry" />
        </mxCell>
        <mxCell id="consumer" value="&lt;b&gt;3 · Kafka + consumer&lt;/b&gt;&lt;br&gt;DELETE đọc before; sự kiện khác đọc after.&lt;br&gt;Tạo is_deleted, cdc_status, _cdc_ts_ms, _cdc_lsn, _kafka_topic / partition / offset.&lt;br&gt;Commit offset sau khi upload Parquet thành công." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF0DD;strokeColor=#C4833A;fontColor=#503313;" vertex="1" parent="1">
          <mxGeometry x="1250" y="160" width="520" height="240" as="geometry" />
        </mxCell>
        <mxCell id="minio" value="&lt;b&gt;4 · MinIO / Parquet&lt;/b&gt;&lt;br&gt;Lưu file theo bảng / date; một file chứa batch event.&lt;br&gt;Chưa chọn bản mới nhất theo PK, chưa join.&lt;br&gt;Nhánh CSV đi thẳng vào MinIO, bỏ qua Debezium / Kafka." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF0DD;strokeColor=#C4833A;fontColor=#503313;" vertex="1" parent="1">
          <mxGeometry x="1840" y="160" width="520" height="240" as="geometry" />
        </mxCell>
        <mxCell id="bronze" value="&lt;b&gt;5 · Snowflake Bronze&lt;/b&gt;&lt;br&gt;raw_data VARIANT + ingested_at + record_hash = MD5(raw record).&lt;br&gt;Dedup bản ghi y hệt; KHÔNG dedup latest PK.&lt;br&gt;COPY lỗi → rollback bảng đó, không báo nạp thành công giả." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF0DD;strokeColor=#C4833A;fontColor=#503313;" vertex="1" parent="1">
          <mxGeometry x="2430" y="160" width="520" height="240" as="geometry" />
        </mxCell>
        <mxCell id="csv" value="&lt;b&gt;CSV marketing (4 file)&lt;/b&gt; · kiểm tra key / grain, thêm _source_batch_id, _source_file_hash, _source_loaded_at; file hash không đổi thì bỏ qua batch." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;fontSize=16;strokeWidth=2;fillColor=#F8F1FC;strokeColor=#9271AC;fontColor=#4C2E61;" vertex="1" parent="1">
          <mxGeometry x="1840" y="425" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="staging" value="&lt;b&gt;LAYER 1 · STAGING — CDC event log có kiểu dữ liệu&lt;/b&gt;&lt;br&gt;CDC: incremental append; chỉ đọc Bronze có raw_data:ingested_at mới hơn watermark target. Parse kiểu và giữ _cdc_ts_ms, _cdc_lsn, is_deleted, ingested_at, record_hash; KHÔNG dedup PK tại đây.&lt;br&gt;Ngoại lệ: stg_res_users và stg_account_partial_reconcile là view. CSV staging giữ thêm metadata batch / file; không phải CDC." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingRight=18;spacingTop=15;fontSize=19;strokeWidth=3;fillColor=#E4F3FF;strokeColor=#468EBB;fontColor=#143F5D;" vertex="1" parent="1">
          <mxGeometry x="70" y="570" width="2880" height="190" as="geometry" />
        </mxCell>

        <mxCell id="header_branch" value="ĐẦU VÀO SAU STAGING" style="rounded=1;html=1;fillColor=#DAEAF7;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#164A70;" vertex="1" parent="1"><mxGeometry x="70" y="800" width="580" height="50" as="geometry" /></mxCell>
        <mxCell id="header_silver" value="SNAPSHOT / LAYER 2 · SILVER" style="rounded=1;html=1;fillColor=#EEDFF5;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#693384;" vertex="1" parent="1"><mxGeometry x="730" y="800" width="620" height="50" as="geometry" /></mxCell>
        <mxCell id="header_dim" value="LAYER 3 · GOLD DIM / FACT" style="rounded=1;html=1;fillColor=#FFE8D4;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#925013;" vertex="1" parent="1"><mxGeometry x="1430" y="800" width="650" height="50" as="geometry" /></mxCell>
        <mxCell id="header_control" value="CỘT JOIN / CẬP NHẬT / NGOẠI LỆ" style="rounded=1;html=1;fillColor=#FFE8D4;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#925013;" vertex="1" parent="1"><mxGeometry x="2180" y="800" width="770" height="50" as="geometry" /></mxCell>
        <mxCell id="fanout" value="" style="rounded=1;fillColor=#4A91BA;strokeColor=#4A91BA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="33" y="868" width="12" height="1472" as="geometry" /></mxCell>

        <mxCell id="snapshot_input" value="&lt;b&gt;A · Nhánh có lịch sử SCD2&lt;/b&gt;&lt;br&gt;stg_res_partner, stg_product_template, stg_hr_contract.&lt;br&gt;Mỗi lần chạy: ROW_NUMBER theo business key; lấy event mới nhất bằng _cdc_ts_ms, _cdc_lsn.&lt;br&gt;Không dùng ingested_at để xếp version." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#EDF6FD;strokeColor=#6FA7CD;fontColor=#143F5D;" vertex="1" parent="1"><mxGeometry x="70" y="880" width="580" height="250" as="geometry" /></mxCell>
        <mxCell id="snapshot" value="&lt;b&gt;SNAPSHOT helper → SILVER SCD2&lt;/b&gt;&lt;br&gt;Snapshot check_cols theo bảng, gồm is_deleted; tạo dbt_scd_id, dbt_valid_from, dbt_valid_to, dbt_updated_at.&lt;br&gt;Silver bỏ version is_deleted=true, join lookup mới nhất; tạo is_current, enrichment_version_key / updated_at.&lt;br&gt;MERGE theo version key; key đổi → nạp lại mọi version của business key." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#F4E9FA;strokeColor=#9D73B9;fontColor=#4C2E61;" vertex="1" parent="1"><mxGeometry x="730" y="880" width="620" height="250" as="geometry" /></mxCell>
        <mxCell id="gold_scd2" value="&lt;b&gt;GOLD DIM SCD2&lt;/b&gt;&lt;br&gt;dim_customer / product / employee giữ TẤT CẢ version từ Silver.&lt;br&gt;MERGE dbt_scd_id; product dùng product_version_id = product × template-version.&lt;br&gt;Tạo customer_sk / product_sk / employee_sk, dim_updated_at; gold_refreshed_at chỉ là giờ chạy pipeline." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF1E2;strokeColor=#D99A58;fontColor=#653A12;" vertex="1" parent="1"><mxGeometry x="1430" y="880" width="650" height="250" as="geometry" /></mxCell>
        <mxCell id="temporal" value="&lt;b&gt;Hợp đồng temporal join cho Fact&lt;/b&gt;&lt;br&gt;business_id khớp; source.silver_updated_at nằm trong [dim.dbt_valid_from, dim.dbt_valid_to).&lt;br&gt;Đây là processing time hiện dùng trong project; business date chỉ dùng để báo cáo.&lt;br&gt;Không ép fact cũ vào version đầu tiên. dim_updated_at giúp phát hiện correction / backfill." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF8EA;strokeColor=#D6B269;fontColor=#654A18;" vertex="1" parent="1"><mxGeometry x="2180" y="880" width="770" height="250" as="geometry" /></mxCell>

        <mxCell id="current_input" value="&lt;b&gt;B · Nguồn giao dịch CDC&lt;/b&gt;&lt;br&gt;Sales, Purchase, CRM, Inventory movement / valuation, Accounting, Manufacturing.&lt;br&gt;Staging append → lấy event mới nhất theo PK, ORDER BY _cdc_ts_ms DESC, _cdc_lsn DESC; sau đó join header / lookup.&lt;br&gt;Giữ tombstone is_deleted." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#EDF6FD;strokeColor=#6FA7CD;fontColor=#143F5D;" vertex="1" parent="1"><mxGeometry x="70" y="1180" width="580" height="250" as="geometry" /></mxCell>
        <mxCell id="silver_current" value="&lt;b&gt;SILVER current-state fact source&lt;/b&gt;&lt;br&gt;Join source chính với parent / lookup mới nhất; derive is_deleted kể cả parent khi có.&lt;br&gt;source_version_key hash các version nguồn phụ thuộc; chỉ MERGE PK khi key này khác target.&lt;br&gt;Tạo silver_updated_at lúc row thực sự INSERT / UPDATE; không tạo SCD2." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#F4E9FA;strokeColor=#9D73B9;fontColor=#4C2E61;" vertex="1" parent="1"><mxGeometry x="730" y="1180" width="620" height="250" as="geometry" /></mxCell>
        <mxCell id="gold_fact" value="&lt;b&gt;GOLD FACT vận hành&lt;/b&gt;&lt;br&gt;Một row theo grain nguồn: ví dụ sale_order_line_id, stock_move_id, account_move_line_id.&lt;br&gt;Join DIM SCD2 bằng khoảng version; DIM lookup bằng business key hiện hành.&lt;br&gt;Tạo fact_*_sk, dimension SK, date key, measures; giữ source_version_key, source_silver_updated_at, is_deleted." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF1E2;strokeColor=#D99A58;fontColor=#653A12;" vertex="1" parent="1"><mxGeometry x="1430" y="1180" width="650" height="250" as="geometry" /></mxCell>
        <mxCell id="fact_refresh" value="&lt;b&gt;Incremental MERGE Fact&lt;/b&gt;&lt;br&gt;Reprocess khi row nguồn mới, source_version_key / source_silver_updated_at đổi, SK DIM đổi, hoặc dim_updated_at mới hơn bản fact giữ.&lt;br&gt;MERGE theo grain key của fact; chỉ Mart lọc is_deleted=false để không tính tombstone.&lt;br&gt;Tùy fact có thêm trigger từ lookup / parent." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF8EA;strokeColor=#D6B269;fontColor=#654A18;" vertex="1" parent="1"><mxGeometry x="2180" y="1180" width="770" height="250" as="geometry" /></mxCell>

        <mxCell id="lookup_input" value="&lt;b&gt;C · Bảng tham chiếu / lookup&lt;/b&gt;&lt;br&gt;Staging vẫn append event. Năm DIM lookup trực tiếp chọn latest theo ID bằng _cdc_ts_ms, _cdc_lsn.&lt;br&gt;Ở năm DIM này, dedup TRƯỚC khi xét is_deleted nên DELETE không làm sống lại version cũ.&lt;br&gt;Không cần Snapshot cho thuộc tính current-state." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#EDF6FD;strokeColor=#6FA7CD;fontColor=#143F5D;" vertex="1" parent="1"><mxGeometry x="70" y="1480" width="580" height="250" as="geometry" /></mxCell>
        <mxCell id="lookup_route" value="&lt;b&gt;Hai đường sang GOLD&lt;/b&gt;&lt;br&gt;1) Staging → Gold trực tiếp: account, journal, warehouse, location, workcenter.&lt;br&gt;2) Staging + CSV campaign master → Silver table → dim_campaign / dim_channel.&lt;br&gt;Lưu ý: Silver campaign/channel hiện lọc is_deleted trước ROW_NUMBER ở vài UTM input; DELETE có nguy cơ lấy lại event cũ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#F4E9FA;strokeColor=#9D73B9;fontColor=#4C2E61;" vertex="1" parent="1"><mxGeometry x="730" y="1480" width="620" height="250" as="geometry" /></mxCell>
        <mxCell id="gold_lookup" value="&lt;b&gt;GOLD DIM lookup / SCD1&lt;/b&gt;&lt;br&gt;materialized=table; năm DIM đọc thẳng Staging chọn latest event, thêm *_sk và active.&lt;br&gt;Tombstone vẫn giữ row với active=false để khóa fact cũ còn resolve được; thuộc tính là current-state, không tái tạo lịch sử.&lt;br&gt;Chỉ dim_location trong nhóm này có dim_updated_at; dim_date là calendar dbt." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF1E2;strokeColor=#D99A58;fontColor=#653A12;" vertex="1" parent="1"><mxGeometry x="1430" y="1480" width="650" height="250" as="geometry" /></mxCell>
        <mxCell id="lookup_caution" value="&lt;b&gt;Khi join Fact&lt;/b&gt;&lt;br&gt;DIM lookup khớp business key; không có dbt_valid_from / to nên không thể temporal join.&lt;br&gt;Đổi thuộc tính lookup không tự reprocess mọi fact: cần model so SK / dim_updated_at, hoặc rebuild fact rõ ràng. gold_refreshed_at KHÔNG phải version business.&lt;br&gt;Với lookup direct, phải latest-row dedup trước khi xét is_deleted." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF8EA;strokeColor=#D6B269;fontColor=#654A18;" vertex="1" parent="1"><mxGeometry x="2180" y="1480" width="770" height="250" as="geometry" /></mxCell>

        <mxCell id="csv_input" value="&lt;b&gt;D · CSV marketing full snapshot&lt;/b&gt;&lt;br&gt;4 file từ loader → MinIO → Bronze → Staging; có source_batch_id, source_file_hash, source_loaded_at, record_hash.&lt;br&gt;Không có _cdc_ts_ms / _cdc_lsn từ PostgreSQL; grain từng file được kiểm tra trước khi nạp." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#EDF6FD;strokeColor=#6FA7CD;fontColor=#143F5D;" vertex="1" parent="1"><mxGeometry x="70" y="1780" width="580" height="250" as="geometry" /></mxCell>
        <mxCell id="silver_csv" value="&lt;b&gt;SILVER CSV table&lt;/b&gt;&lt;br&gt;Chọn batch mới nhất bằng source_loaded_at; ROW_NUMBER theo grain của file, tie-break ingested_at / record_hash.&lt;br&gt;Rebuild table để row đã biến mất khỏi full CSV cũng biến mất.&lt;br&gt;source_version_key = record_hash; silver_updated_at = source_loaded_at." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#F4E9FA;strokeColor=#9D73B9;fontColor=#4C2E61;" vertex="1" parent="1"><mxGeometry x="730" y="1780" width="620" height="250" as="geometry" /></mxCell>
        <mxCell id="gold_csv" value="&lt;b&gt;GOLD FACT CSV&lt;/b&gt;&lt;br&gt;fact_ad_spend, fact_email_campaign, fact_ab_test là table từ Silver full batch.&lt;br&gt;Tạo fact SK, date / channel / campaign SK, measures; không MERGE theo ingested_at để giữ row đã bị xóa khỏi CSV.&lt;br&gt;Ratio ở Mart tính lại từ tổng." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF1E2;strokeColor=#D99A58;fontColor=#653A12;" vertex="1" parent="1"><mxGeometry x="1430" y="1780" width="650" height="250" as="geometry" /></mxCell>
        <mxCell id="gold_derived" value="&lt;b&gt;GOLD FACT dẫn xuất&lt;/b&gt;&lt;br&gt;fact_customer_acquisition = fact_sales + dim_customer + fact_ad_spend.&lt;br&gt;fact_marketing_funnel = fact_ad_spend + fact_crm_funnel + fact_sales + fact_customer_acquisition.&lt;br&gt;Cả hai là table full recompute; KHÔNG đọc stg_customer_acquisition / stg_marketing_funnel_monthly." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF8EA;strokeColor=#D6B269;fontColor=#654A18;" vertex="1" parent="1"><mxGeometry x="2180" y="1780" width="770" height="250" as="geometry" /></mxCell>

        <mxCell id="quant_input" value="&lt;b&gt;E · stock_quant (live state)&lt;/b&gt;&lt;br&gt;Staging append CDC; lấy latest theo stock_quant_id bằng _cdc_ts_ms / _cdc_lsn.&lt;br&gt;Sau dedup mới lọc is_deleted=false và SUM quantity, reserved_quantity theo product × location.&lt;br&gt;Nguồn không tự lưu lịch sử tồn kho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#EDF6FD;strokeColor=#6FA7CD;fontColor=#143F5D;" vertex="1" parent="1"><mxGeometry x="70" y="2080" width="580" height="250" as="geometry" /></mxCell>
        <mxCell id="quant_bypass" value="&lt;b&gt;BỎ QUA SILVER / SNAPSHOT&lt;/b&gt;&lt;br&gt;stock_quant đi trực tiếp Staging → Gold fact_inventory_balance.&lt;br&gt;Không MERGE theo quant_id: fact grain là product × location × snapshot_date_key.&lt;br&gt;Mốc temporal cho product SK là snapshot_captured_at." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#F9F2FC;strokeColor=#B593C8;fontColor=#4C2E61;" vertex="1" parent="1"><mxGeometry x="730" y="2080" width="620" height="250" as="geometry" /></mxCell>
        <mxCell id="gold_balance" value="&lt;b&gt;GOLD FACT inventory balance&lt;/b&gt;&lt;br&gt;delete+insert theo snapshot_date_key; rerun cùng ngày thay toàn bộ partition, ngày cũ vẫn giữ.&lt;br&gt;Tạo snapshot_captured_at, fact_inv_bal_sk và quantity_available = quantity − reserved_quantity.&lt;br&gt;Giữ cả key hôm nay vừa biến mất để ghi balance về 0." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF1E2;strokeColor=#D99A58;fontColor=#653A12;" vertex="1" parent="1"><mxGeometry x="1430" y="2080" width="650" height="250" as="geometry" /></mxCell>
        <mxCell id="snapshot_note" value="&lt;b&gt;Hai kiểu “snapshot” khác nhau&lt;/b&gt;&lt;br&gt;dbt Snapshot (nhánh A) giữ version thuộc tính DIM bằng dbt_scd_id / valid_from / valid_to.&lt;br&gt;Daily inventory balance (nhánh E) chụp số lượng theo snapshot_date_key; không dùng dbt Snapshot.&lt;br&gt;Không dùng ngày đơn hàng để giả lập lịch sử stock_quant." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=16;fontSize=17;strokeWidth=2;fillColor=#FFF8EA;strokeColor=#D6B269;fontColor=#654A18;" vertex="1" parent="1"><mxGeometry x="2180" y="2080" width="770" height="250" as="geometry" /></mxCell>

        <mxCell id="mart" value="&lt;b&gt;LAYER 4 · MART — đọc GOLD, không ref Silver trực tiếp&lt;/b&gt;&lt;br&gt;9 Mart materialized=table, tính lại toàn bộ từ Gold để nhận correction lịch sử và xóa nhóm đã biến mất; mart_ar_aging là ngoại lệ: daily incremental MERGE theo customer_sk × snapshot_date_key.&lt;br&gt;Lọc fact.is_deleted=false ở KPI cần dữ liệu còn hiệu lực; group theo dimension / business date, tính lại tỉ lệ từ SUM, không cộng các ratio đã pre-aggregate.&lt;br&gt;Đầu ra: revenue, delivery, vendor, P&amp;L, DSO / AR aging, OEE, ROAS, email, acquisition." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingRight=18;spacingTop=18;fontSize=20;strokeWidth=3;fillColor=#E5F3E9;strokeColor=#59A274;fontColor=#234D31;" vertex="1" parent="1"><mxGeometry x="70" y="2420" width="2880" height="210" as="geometry" /></mxCell>
        <mxCell id="controls" value="&lt;b&gt;CÁC MỐC KIỂM SOÁT / NƠI BÁO LỖI&lt;/b&gt;&lt;br&gt;Kafka offset commit sau upload MinIO · Snowflake COPY/transaction chặn file lỗi · Bronze record_hash chỉ loại payload y hệt · Staging append không đảm bảo một PK/một row · latest-row dedup xảy ra tại Snapshot, Silver hoặc Gold lookup tùy nhánh.&lt;br&gt;dbt tests theo grain, not_null, relationships và SCD2 interval; Airflow chạy Staging → Snapshot → Silver → Gold → Mart rồi test từng lớp. DELETE before có thể chỉ có PK: kiểm tra replica identity trước khi dựa vào non-key field của tombstone." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingRight=18;spacingTop=16;fontSize=18;strokeWidth=2;fillColor=#F1F4F7;strokeColor=#8797A5;fontColor=#344759;" vertex="1" parent="1"><mxGeometry x="70" y="2670" width="2880" height="160" as="geometry" /></mxCell>

        <mxCell id="e_pg_deb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7E8E;strokeWidth=3;" edge="1" parent="1" source="pg" target="debezium"><mxGeometry relative="1" as="geometry" /></mxCell>
