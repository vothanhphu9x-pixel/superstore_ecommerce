global:
  smtp_smarthost: smtp.gmail.com:587
  smtp_from: alerts@example.invalid
  smtp_auth_username: alerts@example.invalid
  smtp_auth_password_file: /etc/alertmanager/secrets/smtp_password
  smtp_require_tls: true

route:
  receiver: ops-email
  group_by: [alertname, job]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - severity="critical"
      receiver: ops-email
      repeat_interval: 1h

receivers:
  - name: ops-email
    email_configs:
      - to: operator@example.invalid
        send_resolved: true
