# Mẫu duy nhất cho Data Platform. Copy thành data_platform/.env để Docker/Airflow sử dụng.
# Các endpoint bên dưới là tên service trong Docker; khi chạy script trực tiếp trên host,
# override DEBEZIUM_CONNECTOR_URL, KAFKA_BOOTSTRAP_SERVERS, MINIO_ENDPOINT(_URL)
# và DATA_SOURCE_DIR bằng địa chỉ/đường dẫn từ host.

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME

# Odoo PostgreSQL source
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=superstore_erp
POSTGRES_SCHEMA=public
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME

# Debezium connector (Airflow chạy trong Docker network)
DEBEZIUM_CONNECTOR_URL=http://connect:8083/connectors
DEBEZIUM_CONNECTOR_NAME=odoo-connector
DEBEZIUM_SLOT_NAME=superstore_slot
DEBEZIUM_SIGNAL_TOPIC=superstore_server-signal
DEBEZIUM_SIGNAL_REPLICATION_FACTOR=2

# Kafka (kết nối từ container)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092,kafka_2:9093
KAFKA_CONSUMER_GROUP_ID=superstore-minio-consumer
KAFKA_TOPIC_PREFIX=superstore_server
BATCH_SIZE=2000
FLUSH_INTERVAL=10
INACTIVITY_TIMEOUT=20
MAX_RUN_SECONDS=300

# MinIO server
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# MinIO client (kết nối từ container)
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=superstore-bucket
MINIO_BUCKET=superstore-bucket
MINIO_LOCAL_DIR=/tmp/minio_downloads

# CSV files mounted into Airflow
DATA_SOURCE_DIR=/opt/airflow/data_source

# Snowflake (không dùng ACCOUNTADMIN cho pipeline hằng ngày)
SNOWFLAKE_ACCOUNT=ab69840.ap-southeast-7.aws
SNOWFLAKE_USER=YOUR_TRANSFORM_USER
SNOWFLAKE_PASSWORD=CHANGE_ME
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DB=SUPERSTORE_DB
SNOWFLAKE_SCHEMA=BRONZE_LAYER
SNOWFLAKE_LOADER_ROLE=SUPERSTORE_LOADER_ROLE
SNOWFLAKE_DBT_ROLE=SUPERSTORE_DBT_ROLE

# dbt base schema
DBT_SCHEMA=ANALYTIC_LAYER
