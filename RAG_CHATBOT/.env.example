# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# Internal authentication
API_KEY=CHANGE_ME_LONG_RANDOM_INTERNAL_API_KEY
STAFF_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
STAFF_SESSION_TTL_HOURS=12
INTERNAL_EMAIL_DOMAINS=gmail.com

# Customer authentication
CUSTOMER_JWT_SECRET=CHANGE_ME_DIFFERENT_32_RANDOM_CHARACTERS
CUSTOMER_SESSION_TTL_HOURS=12
MAGIC_LINK_TTL_SECONDS=900

# LLM
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_NAME=qwen2.5-7b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# Qdrant and Redis
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=superstore_chatbot_collection
QDRANT_TIMEOUT=30
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
CACHE_KEY_PREFIX=superstore

# Snowflake read-only application access
ANALYTICS_ENABLED=true
SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT
SNOWFLAKE_USER=YOUR_READONLY_USER
SNOWFLAKE_PASSWORD=CHANGE_ME
SNOWFLAKE_DATABASE=SUPERSTORE_DB
SNOWFLAKE_SCHEMA=ANALYTIC_LAYER_GOLD_LAYER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ANALYTICS_READONLY
SNOWFLAKE_MAX_ROWS=1000
SNOWFLAKE_QUERY_TIMEOUT=30

# Odoo read-only access
ODOO_PG_HOST=localhost
ODOO_PG_PORT=5432
ODOO_PG_DB=odoo
ODOO_PG_USER=YOUR_READONLY_USER
ODOO_PG_PASSWORD=CHANGE_ME

# Mail
MAIL_PROVIDER=log
MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=15
N8N_MAIL_WEBHOOK_URL=http://localhost:5678/webhook/superstore-mail
N8N_MAIL_WEBHOOK_SECRET=CHANGE_ME