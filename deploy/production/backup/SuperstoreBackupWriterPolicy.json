{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::superstore-production-backup-703057690904"
    },
    {
      "Sid": "WriteAndVerifyBackupArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectAttributes"
      ],
      "Resource": "arn:aws:s3:::superstore-production-backup-703057690904/superstore-vps/*"
    },
    {
      "Sid": "NeverDeleteOrBypassRetention",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectRetention",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": "arn:aws:s3:::superstore-production-backup-703057690904/superstore-vps/*"
    }
  ]
}
