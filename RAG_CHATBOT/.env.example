# Application
APP_NAME=superstore-api
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:3000

# Internal machine-to-machine authentication
# Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=CHANGE_ME_LONG_RANDOM_INTERNAL_API_KEY

# Redis cache
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900
CACHE_KEY_PREFIX=superstore

# Snowflake read-only application connection
SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT
SNOWFLAKE_USER=YOUR_READONLY_USER
SNOWFLAKE_PASSWORD=CHANGE_ME
SNOWFLAKE_DATABASE=SUPERSTORE_DB
SNOWFLAKE_GOLD_SCHEMA=ANALYTIC_LAYER_GOLD_LAYER
SNOWFLAKE_MART_SCHEMA=ANALYTIC_LAYER_MART_LAYER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ANALYTICS_READONLY
SNOWFLAKE_MAX_ROWS=1000
SNOWFLAKE_QUERY_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/application.log