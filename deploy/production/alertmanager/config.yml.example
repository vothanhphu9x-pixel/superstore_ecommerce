global:
  smtp_smarthost: smtp.gmail.com:587
  smtp_from: alerts@example.invalid
  smtp_auth_username: alerts@example.invalid
  smtp_auth_password_file: /etc/alertmanager/secrets/smtp_password
  smtp_require_tls: true

route:
  receiver: ops-email
  group_by: [alertname, job]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - family="api_5xx"
      receiver: ops-email
      group_by: [alertname, route]
      repeat_interval: 1h
    - matchers:
        - severity="critical"
      receiver: ops-email
      repeat_interval: 1h

inhibit_rules:
  - source_matchers:
      - severity="critical"
      - family=~".+"
    target_matchers:
      - severity="warning"
      - family=~".+"
    equal: [family, instance, route, collection]

receivers:
  - name: ops-email
    email_configs:
      - to: operator@example.invalid
        send_resolved: true
        headers:
          Subject: '[Superstore][Alertmanager][{{ .Status }}] {{ .CommonLabels.alertname }}'
