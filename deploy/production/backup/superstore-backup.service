[Unit]
Description=Superstore encrypted offsite backup
Wants=network-online.target docker.service
After=network-online.target docker.service
RequiresMountsFor=/var/lib/superstore-backup

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/superstore-backup/backup.sh

UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

TimeoutStartSec=2h
KillMode=control-group

StandardOutput=journal
StandardError=journal
SyslogIdentifier=superstore-backup